<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:name=".FourMaApp"
        android:allowBackup="false"
        android:label="4MA"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="xposeddescription"
            android:value="7MA 小程序只读诊断模块（libxposed API 102）" />

        <provider
            android:name=".ReportProvider"
            android:authorities="io.github.jahn2007.fourma.reports"
            android:exported="true" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="4MA 设置"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:label="4MA"
            android:targetActivity=".SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
